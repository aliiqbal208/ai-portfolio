GITHUB_TOKEN=
OPENAI_API_KEY=

# ClamAV configuration (optional)
# Set to true to disable AV scanning (useful for local dev)
CLAMAV_DISABLED=false
# clamd TCP host:port if available; defaults shown below
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Timeouts and size limits
CLAMAV_TIMEOUT_MS=4000
CLAMAV_MAX_BYTES=26214400
